{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "phaser"]
  },
  "include": ["packages/*/src", "apps/*/src", "templates/*/src", "templates/*/playtest.ts", "templates/*/tools", "games/*/src", "games/*/playtest.ts"]
}
